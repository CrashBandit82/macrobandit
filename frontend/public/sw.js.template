/* MacroBandit Service Worker — mit Offline Queue */

const CACHE_VERSION = 'macrobandit-__BUILD_TIME__'
const STATIC_CACHE  = `${CACHE_VERSION}-static`
const API_CACHE     = `${CACHE_VERSION}-api`
const OFFLINE_QUEUE = 'macrobandit-offline-queue'

// ── Install ───────────────────────────────────────────────────────────────────
self.addEventListener('install', (event) => {
  console.log('[SW] Install:', CACHE_VERSION)
  // Nur beim allerersten Install (noch kein aktiver SW) sofort aktivieren.
  // Bei einem Update NICHT skipWaiting → der neue SW bleibt im 'waiting'-State,
  // bis der User im Banner auf "Neu laden" klickt (SKIP_WAITING-Message unten).
  // So gibt es keinen automatischen Reload, laufende Eingaben bleiben erhalten.
  if (!self.registration.active) self.skipWaiting()
  event.waitUntil(
    caches.open(STATIC_CACHE).then(cache =>
      cache.addAll(['/', '/index.html', '/manifest.json'])
    )
  )
})

// ── Activate ──────────────────────────────────────────────────────────────────
self.addEventListener('activate', (event) => {
  // Alle Caches löschen, die nicht zur aktuellen Version gehören.
  // OFFLINE_QUEUE bleibt erhalten (enthält noch nicht gesendete Logs!),
  // sonst gingen ungesendete Einträge bei jedem SW-Update still verloren.
  const valid = [STATIC_CACHE, API_CACHE, OFFLINE_QUEUE]
  event.waitUntil(
    caches.keys()
      .then(keys => Promise.all(
        keys.filter(k => !valid.includes(k)).map(k => caches.delete(k))
      ))
      .then(() => pruneQueue())
      .then(() => self.clients.claim())
  )
})

// ── Auth-Token (nur im Speicher, NIE im Cache-Storage persistiert) ─────────────
let currentToken = null

// Holt den aktuellen Token aktiv vom Client (MessageChannel).
// Rückgabe unterscheidet "Client hat geantwortet" (answered) von "kein Client da".
async function requestTokenFromClients() {
  const all = await self.clients.matchAll({ includeUncontrolled: true })
  if (!all.length) return { answered: false, token: null }
  return new Promise((resolve) => {
    const ch = new MessageChannel()
    let done = false
    ch.port1.onmessage = (e) => { if (!done) { done = true; resolve({ answered: true, token: e.data?.token ?? null }) } }
    try { all[0].postMessage({ type: 'GET_TOKEN' }, [ch.port2]) }
    catch { resolve({ answered: false, token: null }); return }
    setTimeout(() => { if (!done) { done = true; resolve({ answered: false, token: null }) } }, 2000)
  })
}

async function getCurrentToken() {
  const res = await requestTokenFromClients()
  if (res.answered) {
    // Client-Antwort ist verbindlich – auch null (= ausgeloggt), nicht den alten Token nehmen.
    currentToken = res.token
    return res.token
  }
  // Nur bei echter Client-Abwesenheit/Timeout auf den In-Memory-Token zurückfallen.
  return currentToken
}

// ── Offline Queue ─────────────────────────────────────────────────────────────
async function getQueue() {
  const cache = await caches.open(OFFLINE_QUEUE)
  const keys  = await cache.keys()
  const items = []
  for (const key of keys) {
    const res  = await cache.match(key)
    const data = await res.json()
    items.push({ key: key.url, ...data })
  }
  return items
}

async function addToQueue(request) {
  const cache = await caches.open(OFFLINE_QUEUE)
  const body  = await request.clone().text()
  const key   = `offline-${Date.now()}-${Math.random()}`
  // Authorization NICHT mitspeichern – beim Sync wird der dann aktuelle Token
  // verwendet, ein eingefrorener (evtl. abgelaufener) Token darf nicht persistieren.
  const headers = Object.fromEntries(request.headers.entries())
  delete headers.authorization
  await cache.put(
    new Request(`https://offline-queue/${key}`),
    new Response(JSON.stringify({
      url:     request.url,
      method:  request.method,
      body,
      headers,
      timestamp: Date.now()
    }))
  )
  // Clients benachrichtigen
  const clients = await self.clients.matchAll()
  clients.forEach(c => c.postMessage({ type: 'OFFLINE_QUEUED', key }))
}

let syncing = false                 // B4: Sperre gegen parallele syncQueue-Läufe
let reauthRequests = 0              // B1: Backoff/Retry-Zähler für Re-Auth-Anstöße
const MAX_REAUTH_REQUESTS = 3

async function syncQueue() {
  if (syncing) return 0            // B4: bereits ein Lauf aktiv → abbrechen, keine Doppel-Sends
  syncing = true
  try {
    const cache = await caches.open(OFFLINE_QUEUE)
    const keys  = await cache.keys()
    if (!keys.length) return 0

    // Aktuellen Token zur Sync-Zeit holen; ohne Token NICHTS verwerfen → später erneut.
    const token = await getCurrentToken()
    if (!token) return 0

    let synced = 0, needReauth = false
    for (const key of keys) {
      const res  = await cache.match(key)
      const item = await res.json()
      const headers = { ...item.headers, Authorization: `Bearer ${token}` }
      let response
      try {
        response = await fetch(item.url, {
          method:  item.method,
          headers,
          body:    item.body
        })
      } catch {
        break // Noch offline → Rest behalten
      }
      if (response.ok) {
        await cache.delete(key)
        synced++
      } else if (response.status === 401) {
        // Token abgelaufen → Eintrag BEHALTEN (retrybar), begrenzten Re-Auth anstoßen
        needReauth = true
        break
      } else if (response.status === 403) {
        // B1: 403 ist dauerhaft (Re-Auth heilt das nie) → Eintrag behalten, KEIN Re-Auth,
        // keine Schleife; nächste Einträge trotzdem versuchen.
        continue
      } else if (response.status >= 400 && response.status < 500) {
        // Dauerhaft fehlerhafter Request → verwerfen, damit die Queue nicht ewig hängt
        await cache.delete(key)
      } else {
        break // 5xx o.ä. → später erneut
      }
    }

    if (synced > 0) {
      reauthRequests = 0 // Fortschritt → Retry-Budget zurücksetzen
      const clients = await self.clients.matchAll()
      clients.forEach(c => c.postMessage({ type: 'OFFLINE_SYNCED', count: synced }))
    }
    if (needReauth && reauthRequests < MAX_REAUTH_REQUESTS) {
      reauthRequests++ // B1: nur begrenzt oft Re-Auth anstoßen
      const clients = await self.clients.matchAll()
      clients.forEach(c => c.postMessage({ type: 'OFFLINE_AUTH_REQUIRED' }))
    }
    return synced
  } finally {
    syncing = false
  }
}

// Entfernt einmalig wirklich alte (nicht mehr sinnvoll zustellbare) Queue-Einträge.
async function pruneQueue(maxAgeMs = 30 * 24 * 60 * 60 * 1000) { // 30 Tage
  const cache = await caches.open(OFFLINE_QUEUE)
  const keys  = await cache.keys()
  const now   = Date.now()
  for (const key of keys) {
    const res  = await cache.match(key)
    const item = await res.json()
    if (item.timestamp && now - item.timestamp > maxAgeMs) await cache.delete(key)
  }
}

// ── Fetch ─────────────────────────────────────────────────────────────────────
self.addEventListener('fetch', (event) => {
  const { request } = event
  const url = new URL(request.url)

  // Auth-Endpoints: strikt Network-only, kein Cache, kein Cache-Fallback.
  // Verhindert das Ausliefern veralteter/401-Auth-Responses aus dem API_CACHE.
  if (url.pathname.startsWith('/api/auth/')) {
    event.respondWith(fetch(request))
    return
  }

  if (request.method !== 'GET') {
    // POST/PUT/DELETE auf /api/logs offline queuen
    if (url.pathname.startsWith('/api/logs') && request.method === 'POST') {
      event.respondWith(
        fetch(request.clone()).catch(async () => {
          await addToQueue(request)
          return new Response(JSON.stringify({
            id: -1,
            food_name: 'Offline gespeichert',
            offline: true,
            amount_grams: 0, calories: 0, protein: 0, carbs: 0, fat: 0, fiber: 0,
            date: new Date().toISOString().split('T')[0],
            created_at: new Date().toISOString()
          }), { status: 200, headers: { 'Content-Type': 'application/json' } })
        })
      )
      return
    }
    return
  }

  // API → Network First
  if (url.pathname.startsWith('/api/')) {
    event.respondWith(networkFirst(request, API_CACHE, 5000))
    return
  }

  // Open Food Facts → Network First
  if (url.origin === 'https://world.openfoodfacts.org') {
    event.respondWith(networkFirst(request, API_CACHE, 8000))
    return
  }

  // Assets → Stale While Revalidate
  if (url.pathname.startsWith('/assets/')) {
    event.respondWith(staleWhileRevalidate(request, STATIC_CACHE))
    return
  }

  // HTML → Network First
  event.respondWith(networkFirst(request, STATIC_CACHE, 3000))
})

// ── Sync ──────────────────────────────────────────────────────────────────────
self.addEventListener('sync', (event) => {
  if (event.tag === 'sync-logs') {
    event.waitUntil(syncQueue())
  }
})

// ── Push Notifications ───────────────────────────────────────────────────────
self.addEventListener('push', (event) => {
  const data = event.data ? event.data.json() : {}
  const title = data.title || 'MacroBandit'
  const body  = data.body  || 'Vergiss nicht deine Mahlzeiten einzutragen!'

  event.waitUntil(
    self.registration.showNotification(title, {
      body,
      icon:  '/logo.png',
      badge: '/logo.png',
      tag:   'macrobandit-reminder',
      renotify: true,
      data: { url: '/' }
    })
  )
})

self.addEventListener('notificationclick', (event) => {
  event.notification.close()
  event.waitUntil(
    clients.matchAll({ type: 'window' }).then(clientList => {
      for (const client of clientList) {
        if (client.url === '/' && 'focus' in client) return client.focus()
      }
      if (clients.openWindow) return clients.openWindow('/')
    })
  )
})

self.addEventListener('message', (event) => {
  if (event.data?.type === 'SKIP_WAITING') self.skipWaiting()
  if (event.data?.type === 'SET_TOKEN') {
    currentToken = event.data.token || null
    if (currentToken) reauthRequests = 0 // neuer Token → Re-Auth-Budget zurücksetzen
  }
  if (event.data?.type === 'SYNC_NOW') syncQueue()
  if (event.data?.type === 'GET_QUEUE_COUNT') {
    getQueue().then(items => {
      event.source.postMessage({ type: 'QUEUE_COUNT', count: items.length })
    })
  }
})

// ── Strategien ────────────────────────────────────────────────────────────────
async function networkFirst(request, cacheName, timeout = 5000) {
  try {
    const controller = new AbortController()
    const timer = setTimeout(() => controller.abort(), timeout)
    const response = await fetch(request, { signal: controller.signal })
    clearTimeout(timer)
    if (response.ok) {
      const cache = await caches.open(cacheName)
      cache.put(request, response.clone())
    }
    return response
  } catch {
    const cached = await caches.match(request)
    if (cached) return cached
    return new Response(JSON.stringify({ error: 'Offline' }), {
      status: 503,
      headers: { 'Content-Type': 'application/json' }
    })
  }
}

async function staleWhileRevalidate(request, cacheName) {
  const cache   = await caches.open(cacheName)
  const cached  = await cache.match(request)
  const fetchP  = fetch(request).then(r => { if (r.ok) cache.put(request, r.clone()); return r }).catch(() => null)
  return cached || await fetchP
}
